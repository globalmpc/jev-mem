{
  "description": "JEV selects which claude-mem records reach each prompt",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.mjs\" --runtime claude",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
